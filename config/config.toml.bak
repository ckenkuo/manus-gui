# 管线错误集中上报到公网 MySQL（app/error_report.py，切面 + 注解式）。
# 多台 PC 同时跑采集/订单/活动/发布四条管线时，把「主流程失败」（商品失败/批次
# 中止/批次异常退出）结构化写进同一张表，方便按 pipeline/stage/item/machine 聚合排查。
# best-effort：写库失败只告警、绝不中断主流程。
[error_report]
enabled = true
host = "119.29.84.105"
port = 3306
user = "chenkuo"
password = "13928551207Hzg."
database = "manus-gui"
table = "pipeline_errors"
